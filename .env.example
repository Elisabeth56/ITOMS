# apps/server (.env)
DATABASE_URL=
SUPABASE_URL=
WEB_ORIGIN=
# local Supabase only (supabase status -> JWT_SECRET). Never set in production.
SUPABASE_JWT_SECRET=
# optional: lets administrators invite people. Server only.
SUPABASE_SERVICE_ROLE_KEY=
PORT=
# optional: AI quick fix (free tiers). Leave blank to turn the feature off.
GROQ_API_KEY=
GEMINI_API_KEY=
# optional: lets the daily scheduler close stale tickets. Vercel sets it for you.
CRON_SECRET=
